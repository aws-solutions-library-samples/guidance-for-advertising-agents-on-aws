# Copy this file to .env and fill in real values. .env is gitignored.

# A third-party seller reached with auth_type "static_bearer" needs its bearer
# token in an env var named by that entry's auth_token_env, e.g.
#   EXTERNAL_SELLER_AUTH_TOKEN=your-token-here
# Add the variable to runtime_env.build_env_vars too, or the deployed container
# will not receive it. Nothing is required here by default: the sellers this
# project deploys use auth_type "cognito_bearer".

# Registry of AdCP seller (sales) agents the buyer agent can target. Each
# entry needs id/name/url/auth_type; auth_type "static_bearer" also needs
# auth_token_env naming an env var above that holds the token, and
# auth_type "cognito_bearer" mints a fresh token per call using this
# project's own Cognito test user (see COGNITO_* below) - use that for
# seller agents deployed to this same AWS account's AgentCore Runtime,
# e.g. the reference-seller subproject in this repo. "transport" picks
# "mcp" (default if omitted) or "a2a" - the same seller can be listed
# twice under different ids, once per transport, if it exposes both.
# Optional "agent_url": the seller's own canonical AdCP identity (what its
# governance verification code compares an incoming intent token's `aud`
# claim against -- e.g. reference-seller's DEFAULT_AGENT_URL in
# fixtures.py). Falls back to "url" when omitted. For AgentCore-hosted
# sellers this MUST be set and differs from "url": "url" is a
# credential-bearing invoke endpoint that changes on every redeploy, while
# "agent_url" is a stable value declared once in the seller's own code.
# See seller_agents.py for full schema docs. DEFAULT_SELLER_AGENT_ID picks
# which entry is used when a request doesn't specify one.
#
# A seller that exposes both bindings can be listed twice under different ids,
# once per transport. Note the buyer fans out to EVERY entry when a request
# carries no seller_agent_id, so listing the same backend twice means one
# seller answering the same brief twice.
#
# The url below is a placeholder: `deploy_all.py` step 9 (update-seller-json)
# rewrites each entry's url to the real runtime invoke endpoint once that
# seller is deployed.
SELLER_AGENTS_JSON=[{"id":"reference","name":"AdCP Reference Test Seller (AgentCore)","url":"https://bedrock-agentcore.us-east-1.amazonaws.com/runtimes/your-reference-seller-runtime-id/invocations?qualifier=DEFAULT","transport":"mcp","auth_type":"cognito_bearer"}]
DEFAULT_SELLER_AGENT_ID=reference

# Bedrock model used to drive the buyer agent's reasoning.
# Defaults to Claude Sonnet 5 if unset (see agent.py).
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# IAM role AgentCore Runtime assumes to run this agent's container. Read by
# deploy_configure.py's Runtime.configure() call. Create this role (or
# reuse an existing AgentCore execution role) before running deploy_configure.py.
EXECUTION_ROLE_ARN=arn:aws:iam::123456789012:role/your-agentcore-execution-role

# Deployed AgentCore Runtime for the reference seller (../../seller/reference-seller),
# used by verify_reference_seller_live.py to exercise the live MCP endpoint.
REFERENCE_SELLER_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/your-reference-seller-runtime-id

# Optional. The advertiser's domain, used as the default `brand.domain`
# value AdCP requires on get_products requests (see adcp_tools.py's
# adcp_get_products). Sellers use this for brand-safety/policy checks.
# If unset, the agent asks the user for a brand/advertiser instead of
# omitting the field silently. Leave unset for a general-purpose agent
# not tied to one advertiser.
# BUYER_BRAND_DOMAIN=acme.example.com

# S3 bucket for persisting multi-turn conversation state across
# /invocations calls sharing the same AgentCore Runtime session ID.
SESSION_STORAGE_BUCKET=your-session-bucket-name
SESSION_STORAGE_PREFIX=adcp-buyer-agent

# Deployed AgentCore Runtime the UI calls directly from the browser
# (not through this local server). Get this from `python3 deploy_launch.py`
# output, or `aws bedrock-agentcore-control list-agent-runtimes`.
AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/your-agent-id

# Second, separate AgentCore Runtime deployment of the same Buyer Agent,
# speaking the A2A protocol (deploy_buyer_agent_a2a.py / a2a_entrypoint.py)
# instead of this project's own HTTP contract (app.py). This is what makes
# the Buyer Agent invokable by *other* agents, not just this repo's own
# chat UI - see README.md "Buyer Agent as an A2A server". Not read by the
# browser UI; documented here for reference/ops use (e.g. giving this ARN
# to an external agent that wants to call in).
BUYER_AGENT_A2A_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/your-a2a-agent-id

# DynamoDB table backing session_store.py: records every reasoning step
# (incoming request, tool calls/results, final response) for both the HTTP
# and A2A Buyer Agent runtimes, so the chat UI's Sessions dropdown + viewer
# can show live/recent conversations regardless of which runtime handled
# them. Created by `python3 deploy_sessions_table.py`, which also writes
# this value for you.
SESSIONS_TABLE_NAME=adcp-buyer-agent-sessions

# Cognito auth (do not fill these in by hand - run deploy_cognito_setup.py
# and it will write all of these for you, including a generated test user
# password). See README.md "Authentication" for the full picture.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DISCOVERY_URL=
COGNITO_REGION=us-east-1
COGNITO_TEST_USERNAME=
COGNITO_TEST_USER_PASSWORD=
# Comma-separated confidential (client_credentials) app client ids allowed to call the agents,
# in addition to COGNITO_CLIENT_ID. Not secret - these are identifiers, not credentials.
COGNITO_ADDITIONAL_CLIENT_IDS=
