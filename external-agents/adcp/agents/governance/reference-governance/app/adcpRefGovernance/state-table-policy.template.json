{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GovernanceStateTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:${AWS_REGION}:${AWS_ACCOUNT_ID}:table/${INSTANCE_PREFIX}-reference-governance-state",
        "arn:aws:dynamodb:${AWS_REGION}:${AWS_ACCOUNT_ID}:table/${INSTANCE_PREFIX}-reference-governance-state/index/*"
      ]
    }
  ]
}
