{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RecordReasoningSessions",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:GetItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:${AWS_REGION}:${AWS_ACCOUNT_ID}:table/${INSTANCE_PREFIX}-buyer-agent-sessions",
        "arn:aws:dynamodb:${AWS_REGION}:${AWS_ACCOUNT_ID}:table/${INSTANCE_PREFIX}-buyer-agent-sessions/index/*"
      ]
    }
  ]
}
