        <mxCell id="rttext" parent="runtimebox" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#232F3E;spacing=2;" value="&lt;b&gt;Containerized Strands agents&lt;/b&gt;&lt;br&gt;AdFabricAgent routes intent, then agents call each other through&lt;br&gt;invoke_specialist / invoke_specialist_with_RAG — a call graph, not a tier.&lt;br&gt;&lt;br&gt;&lt;b&gt;31 agents · 8 teams&lt;/b&gt;&lt;br&gt;Media Strategy &amp;amp; Planning (7) · Agentic Advertising Ecosystem (7)&lt;br&gt;Publisher Revenue Operations (6) · Creative Strategy (3)&lt;br&gt;Programmatic Trading (3) · Audience &amp;amp; Consumer Intelligence (2)&lt;br&gt;Market &amp;amp; Event Intelligence (2) · Orchestration (1)" vertex="1">
          <mxGeometry height="205" width="455" x="165" y="25" as="geometry" />
        </mxCell>
