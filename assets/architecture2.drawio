        <mxCell id="g3note" parent="g3" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#5A6C86;spacing=2;" value="DynamoDB is the primary config source; S3 and the bundled file are fallback only. The Agent Management UI writes here directly, so edits apply without redeploying." vertex="1">
