        <mxCell id="iam" parent="g9" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.role" value="IAM roles&lt;br&gt;per-runtime · gateway · Cognito" vertex="1">
          <mxGeometry height="78" width="78" x="66" y="210" as="geometry" />
        </mxCell>
        <mxCell id="flowpanel" parent="region" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#B0B7C3;fontSize=11;spacing=8;fontColor=#232F3E;" value="&lt;b&gt;Numbered flow&lt;/b&gt;&lt;br&gt;&amp;#9312; Browser loads the Angular app through CloudFront (WAF-protected).&lt;br&gt;&amp;#9313; CloudFront reads the private S3 UI bucket via Origin Access Control.&lt;br&gt;&amp;#9314; User signs in to the Cognito User Pool; the Identity Pool returns scoped temporary credentials.&lt;br&gt;&amp;#9315; The SPA calls InvokeAgentRuntime (SigV4) on the AgentCore Runtime.&lt;br&gt;&amp;#9316; The runtime loads instructions, agent cards and global config from DynamoDB.&lt;br&gt;&amp;#9317; Agents reason with Claude on Amazon Bedrock.&lt;br&gt;&amp;#9318; Session context is written to and read from AgentCore Memory.&lt;br&gt;&amp;#9319; Tool calls go through the AgentCore Gateway over MCP to Lambda targets.&lt;br&gt;&amp;#9320; RAG queries hit the Bedrock knowledge base backed by OpenSearch Serverless.&lt;br&gt;&amp;#9321; AgencyAgent invokes the AAMP buyer and seller runtimes over A2A JSON-RPC.&lt;br&gt;&amp;#9322; Creative requests fan out to the asynchronous image pipeline.&lt;br&gt;&amp;#9323; Voice runs browser-to-Bedrock: a bidirectional Nova 2 Sonic stream." vertex="1">
          <mxGeometry height="380" width="500" x="1650" y="845" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
